flowchart TD
  q["Who needs to send live data?"] -- "only the server, text" --> sse["Server-Sent Events: one long-lived HTTP response, auto reconnect"]
  q -- "both sides, at any time" --> ws["WebSocket: messages both ways on one connection"]
