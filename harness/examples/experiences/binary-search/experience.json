  "inspect": [
    {
      "id": "mid-formula",
      "scene": "formula",
      "label": "Why round down?",
      "region": {
        "x": 6,
        "y": 24,
        "w": 88,
        "h": 12
      },
      "concept_id": "binary-search",
      "text": "Integer division rounds down, so mid is always a valid index between low and high. In languages with fixed-size integers, low + (high - low) // 2 avoids an overflow of low + high."
    }
  ],
  "checkpoints": [
    {
      "id": "which-half",
      "kind": "predict",
      "at": {
        "scene": "trace"
      },
      "prompt": "The middle element is 16 and the target is 23. Which part of the list can still hold 23?",
      "choices": [
        {
          "text": "Only the part right of 16",
          "correct": true
        },
        {
          "text": "Only the part left of 16",
          "misconception": "Keeps the half with the smaller values, ignoring that the list is sorted ascending"
        },
        {
          "text": "Both halves, so check them all",
          "misconception": "Thinks binary search must still scan every element like linear search"
        }
      ],
      "explanation": "The list is sorted, so every element left of 16 is smaller than 16 and therefore smaller than 23. Only the right part can hold 23, so low moves to mid + 1.",
      "concept_ids": [
        "binary-search"
      ],
      "revisit": "idea"
    },
    {
      "id": "step-count",
      "kind": "predict",
      "at": {
        "scene": "growth"
      },
      "prompt": "About how many comparisons does binary search need for one million sorted items?",
      "choices": [
        {
          "text": "At most 20",
          "correct": true
        },
        {
          "text": "About 500,000",
          "misconception": "Applies the linear search average to binary search"
        },
        {
          "text": "About 1,000",
          "misconception": "Confuses halving with a square root"
        }
      ],
      "explanation": "Each comparison halves the range, and 2 to the power 20 is just over one million, so at most 20 comparisons remain.",
      "concept_ids": [
        "binary-search"
      ],
      "revisit": "growth"
    },
    {
      "id": "empty-range",
      "kind": "experiment",
      "at": {
        "scene": "requirements"
      },
      "prompt": "Search for 40, which is not in the list. Step until the search stops. What are low and high at the end?",
      "goal": {
        "preset": "missing-40",
        "condition": {
          "all": [
            {
              "path": "done",
              "op": "eq",
              "value": true
            }
          ]
        },
        "hint": "Press Next until the caption says the range is empty."
      },
      "explanation": "The search stops when low becomes greater than high. The range of possible positions is then empty, so the value is not in the list.",
      "concept_ids": [
        "binary-search"
      ]
    },
    {
      "id": "needs-sorted",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "Why does binary search fail on an unsorted list?",
      "choices": [
        {
          "text": "Discarding a half is safe only when the order guarantees the target is not there",
          "correct": true
        },
        {
          "text": "Unsorted lists are too long",
          "misconception": "Thinks the length, not the order, is the requirement"
        },
        {
          "text": "The middle index cannot be computed",
          "misconception": "Thinks the formula for mid depends on the values"
        }
      ],
      "explanation": "Binary search drops a half because sorted order proves the target cannot be in it. Without that order, the target could be in the dropped half.",
      "concept_ids": [
        "binary-search"
      ]
    }
  ]
