# Caches (cloned repos, fetched pages)
.cache/

# Dependencies
node_modules/

# Astro site build output
site/dist/
site/.astro/

# tutor CLI lock and temp files
state/.tutor.lock/
*.tmp

# Obsidian per-machine files
vault/.obsidian/workspace*.json
vault/.obsidian/cache
vault/.trash/

# OS and editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Local secrets
.env
.env.*
!.env.example

# HyperFrames working files (the authored video.json and generated project stay tracked)
projects/**/videos/*/renders/
projects/**/videos/*/.hyperframes/
projects/**/videos/*/node_modules/

# Claude Code personal settings (full-permission mode for unattended runs)
.claude/settings.local.json
