{
  "name": "site-network-report",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Check a site's saved DNS, TLS and HAR data against a network policy before launch.",
  "scripts": {
    "start": "node src/main.ts fixtures/good",
    "start:bad": "node src/main.ts fixtures/bad",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
