# All settings are optional. Defaults are shown.
REPORT_FORMAT=text     # text | json
FAIL_ON=error          # error | warning | never
LOG_LEVEL=warn         # silent | warn | info
# Fixed clock for repeatable runs (ISO date). Leave unset to use the real time.
REPORT_NOW=2026-11-18T00:00:00Z
# Optional: policy file. Default is <input dir>/policy.json
# POLICY_FILE=fixtures/good/policy.json
