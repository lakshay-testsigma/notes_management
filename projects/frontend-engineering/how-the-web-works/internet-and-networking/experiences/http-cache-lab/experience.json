  "checkpoints": [
    {
      "id": "why-no-trip",
      "kind": "explain",
      "at": {
        "after": "watch"
      },
      "prompt": "In one sentence: why could the cache answer at 30 seconds without asking the origin?",
      "explanation": "The copy was fresh: its lifetime from max-age=60 was greater than its age of 30 seconds. A fresh copy may be reused with no request to the origin.",
      "concept_ids": [
        "http-caching"
      ]
    },
    {
      "id": "stale-copy",
      "kind": "predict",
      "at": {
        "scene": "stale"
      },
      "prompt": "The copy has max-age=60 and ETag \"v1\" and is now 90 seconds old. The file has not changed. What happens?",
      "choices": [
        {
          "text": "The cache sends If-None-Match: \"v1\" and the origin answers 304",
          "correct": true
        },
        {
          "text": "The cache serves the copy, because it still has one",
          "misconception": "Thinks a stored copy can be reused at any age"
        },
        {
          "text": "The cache deletes the copy and downloads the whole file again",
          "misconception": "Thinks stale means unusable, ignoring validation with the ETag"
        }
      ],
      "explanation": "A stale copy needs validation before reuse. The cache sends the stored ETag in If-None-Match. The file is unchanged, so the origin answers 304 and the cache keeps the stored body.",
      "concept_ids": [
        "validation-etag-last-modified"
      ],
      "revisit": "max-age"
    },
    {
      "id": "no-cache-meaning",
      "kind": "predict",
      "at": {
        "scene": "no-cache-vs-no-store"
      },
      "prompt": "An HTML page says Cache-Control: no-cache and has an ETag. What does the browser do on the next visit?",
      "choices": [
        {
          "text": "It uses its stored copy only after the origin answers 304",
          "correct": true
        },
        {
          "text": "It never stores the page, so it downloads the full page",
          "misconception": "Confuses no-cache with no-store"
        },
        {
          "text": "It serves the stored page without asking",
          "misconception": "Thinks no-cache is ignored when a copy exists"
        }
      ],
      "explanation": "no-cache lets a cache store the response but forbids reuse without validation. The browser sends If-None-Match, and a 304 lets it reuse the stored page. Only no-store forbids storing.",
      "concept_ids": [
        "cache-control-directives"
      ]
    },
    {
      "id": "deploy-miss",
      "kind": "experiment",
      "at": {
        "scene": "hashed"
      },
      "prompt": "In the simulation, step to the request that misses even though the old file is cached for a year. Which URL does it ask for?",
      "goal": {
        "preset": "hashed",
        "condition": {
          "all": [
            {
              "path": "vars.url",
              "op": "eq",
              "value": "app.8b2e7d.js"
            },
            {
              "path": "vars.outcome",
              "op": "eq",
              "value": "MISS"
            }
          ]
        },
        "hint": "Press Forward until the day 31 request after the deploy."
      },
      "explanation": "The cache key includes the URL. A new build gets a new hashed name, so the cache has no stored copy for it and must fetch it once. The year-long lifetime of the old URL does not matter.",
      "concept_ids": [
        "hashed-filenames-cache-busting"
      ]
    },
    {
      "id": "two-variants",
      "kind": "experiment",
      "at": {
        "tab": "practice"
      },
      "prompt": "Load the Vary preset and step until the cache holds two copies of the same URL. Which request header made the second copy?",
      "goal": {
        "preset": "vary",
        "condition": {
          "path": "vars.stored_variants",
          "op": "eq",
          "value": "br, gzip"
        },
        "hint": "Press Forward once, to the gzip request at 10 seconds."
      },
      "explanation": "Vary: Accept-Encoding says the stored response fits only requests with the same Accept-Encoding. The gzip request does not match the br copy, so the cache misses and stores a second copy.",
      "concept_ids": [
        "vary-and-shared-caches"
      ]
    },
    {
      "id": "cdn-lifetime",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "A response says max-age=60, s-maxage=600. At 120 seconds, which cache still serves it as fresh?",
      "choices": [
        {
          "text": "The CDN, a shared cache",
          "correct": true
        },
        {
          "text": "The browser cache",
          "misconception": "Thinks private caches read s-maxage"
        },
        {
          "text": "Both caches",
          "misconception": "Thinks s-maxage replaces max-age for every cache"
        }
      ],
      "explanation": "Only shared caches read s-maxage, and for them it overrides max-age. The browser cache uses max-age=60, so its copy is stale at 120 seconds. The CDN copy is fresh until 600 seconds.",
      "concept_ids": [
        "vary-and-shared-caches",
        "cache-control-directives"
      ]
    }
  ]
}
