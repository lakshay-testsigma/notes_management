{
  "id": "http-cache-lab",
  "title": "HTTP cache lab: hit, revalidate or miss",
  "mode": "hybrid",
  "objective": "Predict whether a request hits the cache, revalidates with a 304, or goes to the origin, from its headers and its age.",
  "level": "intermediate",
  "summary": "An intro video follows one stylesheet through a miss, a fresh hit and a stale revalidation with If-None-Match and 304. A simulation steps through request traces for seven header sets: max-age, no-cache, no-store, a heuristic lifetime, s-maxage at a CDN, Vary: Accept-Encoding, and hashed file names with immutable. A guided walkthrough loads each trace and pauses for predictions, and a summary video connects the cache key, the freshness check and revalidation.",
  "concept_ids": [
    "http-caching",
    "cache-control-directives",
    "validation-etag-last-modified",
    "vary-and-shared-caches",
    "hashed-filenames-cache-busting"
  ],
  "source_ids": [
    "rfc-9111-http-caching",
    "mdn-http-docs",
    "cloudflare-docs",
    "nodejs-undici-repo"
  ],
  "used_in": [
    "site/src/content/lessons/frontend-engineering/how-the-web-works/internet-and-networking/07-http-caching.mdx"
  ],
  "watch": {
    "video": "http-cache-intro"
  },
  "guided": {
    "video": "http-cache-walkthrough"
  },
  "summary_video": "http-cache-summary",
  "fallback_visual": "rfc-9111-mechanism",
  "simulation": {
    "component": "AlgorithmStepper",
    "props": {
      "title": "Cache decision per request: max-age=60",
      "code": "key = \"GET \" + url + varyValues(request)\nentry = store.get(key)\nif (!entry) return fetchFromOrigin()    // MISS\nif (entry.noCache) return revalidate(entry)\nlifetime = shared && sMaxage ? sMaxage : maxAge ?? heuristic(entry)\nif (lifetime > entry.age) return entry   // HIT\nreturn revalidate(entry)                 // stale\n// revalidate: send If-None-Match: entry.etag\n//   304 -> keep body, update headers; 200 -> replace copy\n// store a response only if it has no no-store",
      "lang": "javascript (pseudocode)",
      "speed": 2200,
      "frames": [
        {
          "caption": "Request at 0 s. The cache has no copy of /app.css, so it asks the origin and stores the 200 response.",
          "array": [
            "0 s",
            "30 s",
            "59 s",
            "90 s",
            "120 s"
          ],
          "highlight": [
            0
          ],
          "pointers": {
            "now": 0
          },
          "vars": {
            "cache": "browser",
            "headers": "max-age=60, ETag \"v1\"",
            "age": "none",
            "lifetime": 60,
            "state": "empty",
            "outcome": "MISS"
          },
          "line": 3
        },
        {
          "caption": "Request at 30 s. Lifetime 60 is greater than age 30, so the copy is fresh and the cache answers alone.",
          "array": [
            "0 s",
            "30 s",
            "59 s",
            "90 s",
            "120 s"
          ],
          "highlight": [
            1
          ],
          "pointers": {
            "now": 1
          },
          "vars": {
            "cache": "browser",
            "headers": "max-age=60, ETag \"v1\"",
            "age": 30,
            "lifetime": 60,
            "state": "fresh",
            "outcome": "HIT"
          },
          "line": 6
        },
        {
          "caption": "Request at 59 s. Lifetime 60 is still greater than age 59, so this is still a hit.",
          "array": [
            "0 s",
            "30 s",
            "59 s",
            "90 s",
            "120 s"
          ],
          "highlight": [
            2
          ],
          "pointers": {
            "now": 2
          },
          "vars": {
            "cache": "browser",
            "headers": "max-age=60, ETag \"v1\"",
            "age": 59,
            "lifetime": 60,
            "state": "fresh",
            "outcome": "HIT"
          },
          "line": 6
        },
        {
          "caption": "Request at 90 s. Age 90 is greater than lifetime 60, so the copy is stale. The cache sends If-None-Match: \"v1\", the origin answers 304, and the stored headers are updated.",
          "array": [
            "0 s",
            "30 s",
            "59 s",
            "90 s",
            "120 s"
          ],
          "highlight": [
            3
          ],
          "pointers": {
            "now": 3
          },
          "vars": {
            "cache": "browser",
            "headers": "max-age=60, ETag \"v1\"",
            "age": 90,
            "lifetime": 60,
            "state": "stale",
            "outcome": "REVALIDATE 304"
          },
          "line": 7
        },
        {
          "caption": "Request at 120 s. The 304 at 90 s refreshed the copy, so its age is 30 and it is fresh again.",
          "array": [
            "0 s",
            "30 s",
            "59 s",
            "90 s",
            "120 s"
          ],
          "highlight": [
            4
