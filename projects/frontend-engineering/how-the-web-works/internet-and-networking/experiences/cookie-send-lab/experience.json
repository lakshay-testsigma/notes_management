      "title": "Cookie send checks (teaching pseudo-code, not browser source)",
      "view": "array",
      "code": "for cookie in jar:\n  if not domain_matches(cookie, url.host): skip\n  if not path_matches(cookie, url.path): skip\n  if cookie.secure and url.scheme != \"https\": skip\n  if request_is_cross_site:\n    if cookie.same_site == \"Strict\": skip\n    if cookie.same_site == \"Lax\" and not (top_level and safe_method): skip\n  send(cookie)",
      "lang": "python",
      "speed": 1800,
