{
  "id": "cookie-send-lab",
  "title": "Decide which cookies a request carries",
  "mode": "interactive",
  "objective": "Predict which stored cookies a request carries from Domain, Path, Secure and SameSite, and say what HttpOnly and the __Host- prefix change.",
  "level": "intermediate",
  "summary": "A browser holds five cookies from shop.example.com with different Domain, Path, Secure, HttpOnly and SameSite attributes. A guided walkthrough explains each check, then a stepper runs the checks for seven cases: a same-site fetch, a cross-site link, a cross-site form POST, a cross-site image, a link to a same-site subdomain, a link to plain http, and a set of __Host- and __Secure- cookies that the browser stores or rejects.",
  "concept_ids": [
    "cookies",
    "set-cookie-attributes",
    "cookie-prefixes-and-chips",
    "third-party-cookies"
  ],
  "source_ids": [
    "mdn-http-docs",
    "whatwg-url-standard",
    "nodejs-undici-repo"
  ],
  "used_in": [
    "site/src/content/lessons/frontend-engineering/how-the-web-works/internet-and-networking/10-cookies.mdx"
  ],
  "guided": {
    "video": "cookie-send-walkthrough"
  },
  "fallback_visual": "cookie-send-checks",
  "sync": [
    {
      "scene": "jar",
      "preset": "same-site-fetch"
    },
    {
      "scene": "cross-site-link",
      "preset": "cross-site-link"
    },
    {
      "scene": "cross-site-post",
      "preset": "cross-site-post"
    },
    {
      "scene": "prefixes",
      "preset": "prefix-check"
    }
  ],
  "inspect": [
    {
      "id": "lax-navigation",
      "scene": "same-site",
      "label": "What counts as top-level?",
      "region": {
        "x": 6,
        "y": 40,
        "w": 88,
        "h": 14
      },
      "concept_id": "set-cookie-attributes",
      "text": "A top-level navigation changes the URL in the address bar: a link click, a document.location assignment or a form submission. fetch() calls, <img> and <script> requests, and navigations inside an <iframe> are not top-level, so Lax cookies stay home on cross-site requests of that kind."
    },
    {
      "id": "host-prefix",
      "scene": "prefixes",
      "label": "Why __Host- is strongest",
      "region": {
        "x": 52,
        "y": 30,
        "w": 42,
        "h": 40
      },
      "concept_id": "cookie-prefixes-and-chips",
      "text": "With no Domain, the cookie goes only to the host that set it. With Path=/, no other path on that host can set a cookie that overrides it. Secure keeps it on https. MDN calls this the closest a cookie gets to an origin boundary."
    }
  ],
  "checkpoints": [
    {
      "id": "post-prediction",
      "kind": "predict",
      "at": {
        "scene": "cross-site-post"
      },
      "prompt": "A form on news.other.org sends POST to shop.example.com/account/pay. Which of the five cookies does the request carry?",
      "choices": [
        {
          "text": "Only widget (SameSite=None)",
          "correct": true
        },
        {
          "text": "__Host-sid, widget and theme, like the link click",
          "misconception": "Thinks Lax allows every cross-site top-level navigation, whatever the method"
        },
        {
          "text": "All five, because the user started the request",
          "misconception": "Thinks a user action makes a cross-site request count as same-site"
        },
        {
          "text": "None, because the request is cross-site",
          "misconception": "Thinks every cross-site request drops all cookies, ignoring SameSite=None"
        }
      ],
      "explanation": "Lax allows a cross-site request only when it is a top-level navigation with a safe method. POST is not safe, so the Lax cookies stay home and Strict never goes cross-site. SameSite=None allows every request, so widget goes.",
      "concept_ids": [
        "set-cookie-attributes",
        "cookies"
      ],
      "revisit": "same-site"
    },
    {
      "id": "post-experiment",
      "kind": "experiment",
      "at": {
        "tab": "practice"
      },
      "prompt": "Load the form POST case and step through the checks. Which check removes the Lax cookies?",
      "goal": {
        "preset": "cross-site-post",
        "condition": {
          "all": [
            {
              "path": "done",
              "op": "eq",
              "value": true
            },
            {
              "path": "vars.sent",
              "op": "eq",
              "value": "widget"
            }
          ]
        },
        "hint": "Press Next until the SameSite line is highlighted and the sent value appears."
      },
      "explanation": "Domain, Path and Secure keep all five cookies, because the URL is https on shop.example.com under /account. Only the SameSite check removes cookies here: Strict and Lax both stay home on a cross-site POST.",
      "concept_ids": [
        "set-cookie-attributes"
      ]
    },
    {
      "id": "subdomain-prediction",
      "kind": "predict",
      "at": {
        "scene": "domain-path"
      },
      "prompt": "A link on shop.example.com opens blog.example.com. Does the host-only __Host-sid cookie go with the request?",
      "choices": [
        {
          "text": "No, a host-only cookie goes only to shop.example.com",
          "correct": true
        },
        {
          "text": "Yes, because the request is same-site",
          "misconception": "Thinks SameSite decides which hosts receive a cookie, not Domain"
        },
        {
          "text": "Yes, because blog is a subdomain of example.com",
          "misconception": "Thinks a cookie without Domain also goes to sibling subdomains"
        }
      ],
      "explanation": "Domain decides which hosts receive a cookie. Without Domain the cookie is host-only, so blog.example.com never gets __Host-sid. SameSite is a separate check that only removes cookies; it never adds a host.",
      "concept_ids": [
        "set-cookie-attributes",
        "cookie-prefixes-and-chips"
      ],
      "revisit": "domain-path"
    },
    {
      "id": "httponly-verify",
      "kind": "verify",
      "at": {
        "scene": "secure-httponly"
      },
      "prompt": "Page JavaScript calls fetch('/account/orders') on the same site. What happens to the HttpOnly cookie __Host-sid?",
      "choices": [
        {
          "text": "The request carries it, but document.cookie does not show it",
          "correct": true
        },
        {
          "text": "The request leaves it out, because JavaScript started the request",
          "misconception": "Thinks HttpOnly blocks cookies on script-initiated requests"
        },
        {
          "text": "document.cookie shows it, because the page is same-site",
          "misconception": "Thinks HttpOnly applies only on cross-site pages"
        }
      ],
      "explanation": "HttpOnly forbids JavaScript access through document.cookie. It does not change what the request carries, so fetch and XMLHttpRequest still send the cookie. This limits what an XSS script can read.",
      "concept_ids": [
        "set-cookie-attributes",
        "cookies"
      ],
      "revisit": "secure-httponly"
    },
    {
      "id": "prefix-verify",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "A server sends Set-Cookie: __Host-sid=abc; Secure; Path=/; Domain=example.com. What does the browser do?",
      "choices": [
        {
          "text": "It rejects the cookie, because __Host- forbids Domain",
          "correct": true
        },
        {
          "text": "It stores the cookie for every subdomain of example.com",
          "misconception": "Thinks the prefix is only a naming habit with no rules"
        },
        {
          "text": "It stores the cookie and silently removes Domain",
          "misconception": "Confuses browser behavior with a server library that fixes the header"
        }
      ],
      "explanation": "A __Host- cookie must have Secure, Path=/ and no Domain, so a browser that supports prefixes rejects this header. Server libraries such as undici's setCookie drop Domain when they write a __Host- cookie, but the browser itself only accepts or rejects.",
      "concept_ids": [
        "cookie-prefixes-and-chips"
      ]
    }
  ],
  "simulation": {
    "component": "AlgorithmStepper",
