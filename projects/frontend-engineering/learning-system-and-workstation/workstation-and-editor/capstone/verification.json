{
  "checks": [
    { "kind": "solution-tests", "command": "npm", "args": ["test"] },
    { "kind": "typecheck", "command": "npm", "args": ["run", "typecheck"] },
    { "kind": "build", "command": "npm", "args": ["run", "build"] },
    { "kind": "audit", "command": "npm", "args": ["audit", "--audit-level=high", "--omit=dev"] }
  ]
}
