  "inspect": [
    {
      "id": "where-grep-lives",
      "scene": "stages",
      "label": "Where does Bash find grep?",
      "region": {
        "x": 4,
        "y": 30,
        "w": 92,
        "h": 40
      },
      "concept_id": "path-and-env-vars",
      "text": "Bash looks for commands such as grep, sort and uniq in the directories listed in the PATH variable. PATH is a colon-separated list of directories, for example /usr/local/bin:/usr/bin:/bin."
    }
  ],
  "checkpoints": [
    {
      "id": "what-sort-reads",
      "kind": "predict",
      "at": {
        "scene": "stages"
      },
      "prompt": "grep 404 writes five lines. What does sort write to its standard output in this pipeline?",
      "choices": [
        {
          "text": "The same five lines, with equal lines next to each other",
          "correct": true
        },
        {
          "text": "Two lines, each with a count in front",
          "misconception": "Thinks sort counts or removes duplicates, which is the job of uniq -c later in the pipeline"
        },
        {
          "text": "All seven lines of access.log in order",
          "misconception": "Thinks every command in a pipeline reads the original file instead of the previous command's output"
        }
      ],
      "explanation": "In a pipeline each command reads the previous command's output through the pipe. sort gets only the five lines grep wrote, and it changes their order, not their number.",
      "concept_ids": [
        "pipes-and-redirection"
      ],
      "revisit": "pipe"
    },
    {
      "id": "where-error-goes",
      "kind": "predict",
      "at": {
        "scene": "stderr"
      },
      "prompt": "You run ls notes.txt missing.txt 2>&1 > out.txt. Where does the error message about missing.txt appear?",
      "choices": [
        {
          "text": "On the terminal",
          "correct": true
        },
        {
          "text": "In out.txt, with the file list",
          "misconception": "Thinks 2>&1 ties stderr to stdout forever, so stderr follows stdout wherever it moves later"
        },
        {
          "text": "Nowhere, the redirection throws it away",
          "misconception": "Thinks a redirection of stderr discards the error instead of pointing it at a destination"
        }
      ],
      "explanation": "Bash processes redirections from left to right. 2>&1 makes stderr a copy of stdout while stdout is still the terminal; > out.txt then moves only stdout.",
      "concept_ids": [
        "pipes-and-redirection"
      ],
      "revisit": "stderr"
    },
    {
      "id": "pipe-ampersand",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "Which command line does the same as ls notes.txt missing.txt |& grep missing?",
      "choices": [
        {
          "text": "ls notes.txt missing.txt 2>&1 | grep missing",
          "correct": true
        },
        {
          "text": "ls notes.txt missing.txt | grep missing",
          "misconception": "Thinks a plain pipe already carries standard error to the next command"
        },
        {
          "text": "ls notes.txt missing.txt | grep missing 2>&1",
          "misconception": "Thinks a redirection written on grep changes where ls sends its errors"
        }
      ],
      "explanation": "The Bash manual says |& is shorthand for 2>&1 |: it connects the first command's standard error, as well as its standard output, to the next command's standard input.",
      "concept_ids": [
        "pipes-and-redirection"
      ]
    }
  ]
}
