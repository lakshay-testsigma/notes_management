{
  "id": "shell-pipeline-lab",
  "title": "Build a shell pipeline stage by stage",
  "mode": "interactive",
  "objective": "Predict the output of each pipeline stage and explain where a redirection sends standard error.",
  "level": "beginner",
  "summary": "A short walkthrough sends a seven-line web server log through cat access.log | grep 404 | sort | uniq -c | sort -rn and pauses for predictions. In the stepper, each step shows one stage's standard input next to its standard output. A second trace leaves out sort, and a third shows how Bash processes > out.txt and 2>&1 from left to right, so their order decides where the error message goes.",
  "concept_ids": [
    "terminal-shell-basics",
    "pipes-and-redirection",
    "path-and-env-vars"
  ],
  "source_ids": [
    "gnu-bash-manual"
  ],
  "used_in": [
    "site/src/content/lessons/frontend-engineering/learning-system-and-workstation/workstation-and-editor/01-terminal-and-shell.mdx"
  ],
  "watch": {
    "video": "shell-pipeline-flow"
  },
  "guided": {
    "video": "shell-pipeline-flow"
  },
  "fallback_visual": "shell-pipeline-stages",
