    {
      "id": "step-count",
      "kind": "predict",
      "at": {
        "scene": "halve"
      },
      "prompt": "HEAD (c16) is bad and c1 is good. About how many commits must you test before Git names the first bad commit?",
      "choices": [
        {
          "text": "About 4",
          "correct": true
        },
        {
          "text": "About 15, one for each suspect commit",
          "misconception": "Thinks bisect tests every commit in order, like a linear search"
        },
        {
          "text": "About 8, half of the commits",
          "misconception": "Thinks bisect halves the range only once instead of at every test"
        }
      ],
      "explanation": "Each answer removes about half of the suspect commits: 16, 8, 4, 2, 1. That is about log2(16) = 4 tests. Pro Git shows the same halving: 6 revisions left, then 3, then 1.",
      "concept_ids": [
        "git-bisect"
      ],
      "revisit": "start"
    },
    {
      "id": "find-c3",
      "kind": "experiment",
      "at": {
