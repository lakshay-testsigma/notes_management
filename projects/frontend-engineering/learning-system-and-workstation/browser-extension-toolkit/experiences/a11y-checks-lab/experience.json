      "label": "What counts as large text?",
      "region": {
        "x": 52,
        "y": 25,
        "w": 44,
        "h": 50
      },
      "concept_id": "contrast-and-vision-checks",
      "text": "Large text is at least 18 point, or 14 point when bold. axe converts the computed font size to points and reads the weight before it picks 3:1 or 4.5:1."
    }
  ],
  "checkpoints": [
    {
      "id": "gray-777777",
      "kind": "predict",
      "at": {
        "scene": "rounding"
      },
      "prompt": "Normal-size gray #777777 text on white measures 4.478:1. What does the color-contrast check report?",
      "choices": [
        {
          "text": "Fail: 4.47 is below 4.5",
          "correct": true
        },
        {
          "text": "Pass: 4.478 rounds to 4.5",
          "misconception": "Thinks a ratio just under the threshold may be rounded up to meet it"
        },
        {
          "text": "Incomplete: it is too close to call",
          "misconception": "Thinks incomplete means a borderline number, not unknown colors"
        }
      ],
      "explanation": "The threshold is a hard minimum. axe rounds the ratio down to 4.47 before it reports it, so a near miss never shows as a pass. Incomplete is only for cases where the colors cannot be known.",
      "concept_ids": [
        "contrast-and-vision-checks",
        "automated-a11y-rule-limits"
      ],
      "revisit": "thresholds"
    },
    {
      "id": "skip-to-h4",
      "kind": "predict",
      "at": {
        "scene": "headings"
      },
      "prompt": "The page has h1, then h2, then h4. What does heading-order report for the h4?",
      "choices": [
        {
          "text": "Fail: it skips h3",
          "correct": true
        },
        {
          "text": "Pass: h4 is valid HTML",
          "misconception": "Thinks a rule checks only that each tag is valid, not its order"
        },
        {
          "text": "Incomplete: only a person can judge order",
          "misconception": "Thinks heading order is a human-only judgment, though levels are measurable"
        }
      ],
      "explanation": "heading-order compares each heading with the one before it. A heading may be at most one level deeper than the previous one, so h4 after h2 fails.",
      "concept_ids": [
        "accessibility-extensions",
        "automated-a11y-rule-limits"
      ],
      "revisit": "headings"
    },
    {
      "id": "heading-cannot-tell",
      "kind": "experiment",
      "at": {
        "scene": "limits"
      },
      "prompt": "Step through the heading changes until the check cannot decide. Why does it answer incomplete there?",
      "goal": {
        "preset": "heading-order",
        "condition": {
          "path": "vars.result",
          "op": "eq",
          "value": "incomplete"
        },
        "hint": "Press Next until the result variable shows incomplete."
      },
      "explanation": "The check needs the previous heading to compare levels. When that heading is outside the scanned part, it cannot judge, so it answers incomplete instead of a false fail.",
      "concept_ids": [
        "automated-a11y-rule-limits"
      ]
    },
    {
      "id": "large-text-fails",
      "kind": "experiment",
      "at": {
        "tab": "practice"
      },
      "prompt": "Change the text color and size until large text fails the contrast check.",
      "goal": {
        "preset": "contrast-sweep",
        "condition": {
          "all": [
            {
              "path": "vars.result",
              "op": "eq",
              "value": "fail"
            },
            {
              "path": "vars.needed",
              "op": "eq",
              "value": 3
            }
          ]
        },
        "hint": "Step past the 24px rows until a large-text row fails."
      },
      "explanation": "Large text needs only 3:1, but #959595 on white is 2.995:1, rounded down to 2.99. That is below 3, so even large text fails.",
      "concept_ids": [
        "contrast-and-vision-checks"
      ]
    },
    {
      "id": "zero-violations",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "An extension scan of your page shows zero violations. What do you know?",
