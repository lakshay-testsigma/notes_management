{
  "id": "a11y-checks-lab",
  "title": "Change colors and headings, predict the accessibility check",
  "mode": "interactive",
  "objective": "Predict whether an automated contrast or heading-order check passes, fails or returns incomplete, and name what a person must still review.",
  "level": "intermediate",
  "summary": "A guided walkthrough of how an axe-style scan judges color contrast and heading order, paused for predictions, with a stepper where the learner changes text colors, text size and heading levels. Gray #767676 on white passes at 4.54:1; #777777 fails at 4.47:1 because the ratio is rounded down; large text needs only 3:1; text on a background image or a heading whose previous heading cannot be found returns incomplete. No rule judges heading meaning, so a person still reviews.",
  "concept_ids": [
    "accessibility-extensions",
    "automated-a11y-rule-limits",
    "contrast-and-vision-checks"
  ],
  "source_ids": [
    "dequelabs-axe-core-repo",
    "w3c-wai-selecting-evaluation-tools",
    "w3c-wcag22-understanding-contrast-minimum"
  ],
  "used_in": [
    "site/src/content/lessons/frontend-engineering/learning-system-and-workstation/browser-extension-toolkit/04-accessibility-extensions.mdx"
  ],
  "guided": {
    "video": "a11y-checks-walkthrough"
  },
  "fallback_visual": "a11y-check-outcomes",
