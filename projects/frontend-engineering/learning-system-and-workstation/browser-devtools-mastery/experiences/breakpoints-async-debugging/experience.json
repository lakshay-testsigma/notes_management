  "checkpoints": [
    {
      "id": "which-wins",
      "kind": "predict",
      "at": {
        "scene": "two-requests"
      },
      "prompt": "Both requests are in flight and the re request is slower. What does the label say at the end?",
      "choices": [
        {
          "text": "Results for re, because the slow response arrives last and overwrites the list",
          "correct": true
        },
        {
          "text": "Results for react, because react was typed last",
          "misconception": "Thinks responses arrive in the order the requests were sent"
        },
        {
          "text": "An error, because the browser blocks the second fetch until the first ends",
          "misconception": "Thinks the browser runs only one fetch at a time"
        }
      ],
      "explanation": "Each input event starts its own fetch, and both run at the same time. render runs once per response, in the order the responses arrive, so the slow re response writes the list last.",
      "concept_ids": [
        "breakpoint-debugging"
      ],
      "revisit": "the-bug"
    },
    {
      "id": "find-stale-pause",
      "kind": "experiment",
      "at": {
        "scene": "line-pause"
      },
      "prompt": "In the stepper, use the line-of-code breakpoint and step until DevTools is paused on the stale response.",
      "goal": {
        "preset": "line-breakpoint",
        "condition": {
          "all": [
            {
              "path": "vars.query",
              "op": "eq",
              "value": "re"
            },
            {
              "path": "pointers.paused",
              "op": "eq",
              "value": 0
            }
          ]
        },
        "hint": "Press Forward past the first pause for react, and stop at the pause where query is re."
      },
      "explanation": "A line-of-code breakpoint pauses for every response. The second pause is the stale one: query is re, the box says react, so the watch query === input.value is false.",
      "concept_ids": [
        "breakpoint-debugging"
      ]
    },
    {
      "id": "which-breakpoint",
      "kind": "verify",
      "at": {
        "slide": "types"
      },
      "prompt": "You want DevTools to pause only on the stale response. Which breakpoint do you set on line 5?",
      "choices": [
        {
          "text": "A conditional breakpoint with query !== input.value",
          "correct": true
        },
        {
          "text": "A plain line-of-code breakpoint",
          "misconception": "Thinks a line breakpoint can tell fresh and stale calls apart"
        },
        {
          "text": "A logpoint",
          "misconception": "Thinks a logpoint pauses the code like a breakpoint"
        }
      ],
      "explanation": "A conditional breakpoint pauses only when its condition is true. The condition is true only when the call read an old query, so DevTools skips the fresh response.",
      "concept_ids": [
        "breakpoint-debugging"
      ]
    },
    {
      "id": "top-after-step-into",
      "kind": "predict",
      "at": {
        "scene": "step-into"
      },
      "prompt": "You are paused on line 5 and press Step into. What is on top of the Call Stack?",
      "choices": [
        {
          "text": "render, line 8",
          "correct": true
        },
        {
          "text": "onInput, line 6",
          "misconception": "Confuses step into with step over, which runs render whole"
        },
        {
          "text": "Nothing, the stack is empty",
          "misconception": "Thinks stepping resumes the code like Resume does"
        }
      ],
      "explanation": "Step into enters the function called on the current line. render now runs, so DevTools adds its frame on top of onInput and pauses on its first line.",
      "concept_ids": [
        "breakpoint-debugging"
      ],
      "revisit": "conditional"
    },
    {
      "id": "why-async-frames",
      "kind": "explain",
      "at": {
        "tab": "practice"
      },
      "prompt": "In one sentence: why do you need async frames in the Call Stack to explain this race?",
      "explanation": "After an await, the stack holds only the resumed code, so it cannot show which input event started the request. Async frames link the resumed code back to onInput line 4, where query re was read and the fetch started.",
      "concept_ids": [
        "async-call-stacks"
      ]
    }
  ]
}
