      "view": "array",
      "code": "input.addEventListener('input', onInput);\nasync function onInput() {\n  const query = input.value;\n  const items = await getJSON('/search?q=' + query);\n  render(query, items);\n}\nfunction render(query, items) {\n  list.textContent = items.join(', ');\n  label.textContent = 'Results for ' + query;\n}\nasync function getJSON(url) {\n  const res = await fetch(url);\n  return res.json();\n}",
