  "sync": [
    {
      "scene": "waiting",
      "preset": "slow-server"
    },
    {
      "scene": "throttling",
      "preset": "slow-4g"
    },
    {
      "scene": "cache",
      "preset": "cache-repeat-visit"
    }
  ],
  "checkpoints": [
    {
      "id": "phase-order",
      "kind": "predict",
      "at": {
        "scene": "phases"
      },
      "prompt": "Which phase must finish before Request sent can start on a new HTTPS connection?",
      "choices": [
        {
          "text": "Initial connection, with its TCP handshakes and SSL negotiation",
          "correct": true
        },
        {
          "text": "Waiting (TTFB)",
          "misconception": "Thinks the server answers before the request reaches it"
        },
        {
          "text": "Content Download",
          "misconception": "Thinks the body downloads before the request is sent"
        }
      ],
      "explanation": "The Timing tab lists the phases in order. The request travels over the connection, so Initial connection, which covers the TCP handshakes and SSL negotiation, comes before Request sent.",
      "concept_ids": [
        "request-timing-phases"
      ],
      "revisit": "phases"
    },
    {
      "id": "slow-server-experiment",
      "kind": "experiment",
      "at": {
        "scene": "waiting"
      },
      "prompt": "Load the Slow server preset and step to the last phase. Which bar is now the longest, and how does it compare with the No throttling preset?",
      "goal": {
        "preset": "slow-server",
        "condition": {
          "all": [
            {
              "path": "vars.profile",
              "op": "eq",
              "value": "Slow server"
            },
            {
              "path": "done",
              "op": "eq",
              "value": true
            }
          ]
        },
        "hint": "Press Forward until the caption names Content Download, then compare the Waiting (TTFB) bar."
      },
      "explanation": "Waiting (TTFB) is one round trip plus server processing time. A slow server adds processing time, so only Waiting grows while Content Download stays short.",
      "concept_ids": [
        "request-timing-phases"
      ]
    },
    {
      "id": "throttle-predict",
      "kind": "predict",
      "at": {
        "scene": "throttling"
      },
      "prompt": "You switch Throttling from No throttling to Slow 4G. Which phases grow the most?",
      "choices": [
        {
          "text": "Waiting (TTFB) and Content Download",
          "correct": true
        },
        {
          "text": "Only Queueing",
          "misconception": "Thinks throttling adds more requests to the queue instead of slowing the network"
        },
        {
          "text": "None, throttling only slows the CPU",
          "misconception": "Confuses network throttling with CPU throttling in the Performance panel"
        }
      ],
      "explanation": "Waiting includes one round trip and Content Download reads the body over the network. A slower network makes each round trip and each byte slower, so these two phases grow.",
      "concept_ids": [
        "network-panel",
        "request-timing-phases"
      ],
      "revisit": "throttling"
    },
    {
      "id": "cache-predict",
      "kind": "predict",
      "at": {
        "scene": "cache"
      },
      "prompt": "Disable cache is off and you reload a page you visited before. What happens to a cached file?",
      "choices": [
        {
          "text": "It loads from the browser cache, as on a repeat visit",
          "correct": true
        },
        {
          "text": "It downloads again with every phase",
          "misconception": "Thinks the browser ignores its cache unless DevTools forces it"
        },
        {
          "text": "It fails until you clear the cache",
          "misconception": "Thinks a cached file blocks a new load"
        }
      ],
      "explanation": "Repeat visits normally load files from the browser cache. Disable cache turns that off, so the page loads like a first-time visit and every request goes to the network.",
      "concept_ids": [
        "network-panel"
      ],
      "revisit": "cache"
    },
    {
      "id": "diagnose",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "One request shows Queueing 900 ms and every other phase short. What is the most likely cause?",
      "choices": [
        {
          "text": "Too many requests compete, for example for the six connections per origin of HTTP/1.1",
          "correct": true
        },
        {
          "text": "The server is slow to answer",
          "misconception": "Reads any long bar as server time instead of Waiting (TTFB)"
        },
        {
          "text": "The file is very large",
          "misconception": "Confuses Queueing with Content Download"
        }
      ],
      "explanation": "Queueing is the time before the request starts: it waits for higher-priority requests, a free connection or disk cache space. A slow server shows in Waiting (TTFB), and a large file in Content Download.",
      "concept_ids": [
        "request-timing-phases"
      ]
    }
  ]
}
