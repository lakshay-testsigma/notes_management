{
  "id": "network-panel-waterfall",
  "title": "Change the conditions and watch the request phases grow",
  "mode": "interactive",
  "objective": "Name the timing phases of one request in order and say which phase a slow network, a slow server or the cache changes.",
  "level": "beginner",
  "summary": "A guided walkthrough of the Network panel Timing tab, paused for predictions, and a stepper that draws one request phase by phase: Queueing, Stalled, DNS Lookup, Initial connection, Request sent, Waiting (TTFB) and Content Download. Presets switch between no throttling, Fast 4G, Slow 4G, a slow server and a repeat visit with Disable cache off, so the learner sees which phases grow. All millisecond values are example numbers.",
  "concept_ids": [
    "network-panel",
    "request-timing-phases"
  ],
  "source_ids": [
    "chrome-devtools-network-reference"
  ],
  "used_in": [
    "site/src/content/lessons/frontend-engineering/learning-system-and-workstation/browser-devtools-mastery/06-network-panel-waterfall.mdx"
  ],
  "guided": {
    "video": "network-waterfall-walkthrough"
  },
  "fallback_visual": "request-timing-phases-sequence",
  "simulation": {
    "component": "AlgorithmStepper",
    "props": {
      "title": "One request in the Timing tab (example numbers)",
      "view": "bars",
      "speed": 1400,
      "frames": [
