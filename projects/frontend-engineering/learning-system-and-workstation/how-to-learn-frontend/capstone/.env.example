# Copy this file to .env and change the values when you need to.
#
# Everything in a VITE_ variable is built into the browser bundle, so it is
# public. Never put an API key, a token or a password in this file.

# The key the learning log is saved under in the browser's local storage.
VITE_TRACKER_STORAGE_KEY=learning-tracker

# The shape of the saved log. The app migrates an older version on the fly.
VITE_TRACKER_SCHEMA_VERSION=2

# The lowest log level the app writes: debug, info, warn or error.
VITE_TRACKER_LOG_LEVEL=info
