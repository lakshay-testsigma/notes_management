          "vars": {
            "when": "step 3",
            "supported": "6 of 7",
            "months_since_newly": "not started",
            "status": "Limited availability"
          },
          "line": 5
        },
        {
          "caption": "Safari on iOS ships it. Every core browser supports Feature X, so today is its newly interoperable date: Newly available.",
          "array": [
            "Chrome",
