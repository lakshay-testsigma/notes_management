{
  "id": "baseline-status-lab",
  "title": "Move a feature through the Baseline labels",
  "mode": "interactive",
  "objective": "Predict a feature's Baseline label from its core-browser support and the months since it became Newly available.",
  "level": "beginner",
  "summary": "A guided walkthrough of the Baseline lifecycle, paused for predictions, and a stepper with seven core-browser cells. Highlighted cells are browsers that support the feature. The learner adds browsers one by one and runs the 30-month clock, and watches the label move from Limited availability to Newly available to Widely available. The :has() selector, Newly available in December 2023, is the worked example. A last question reads the Can I use color legend.",
  "concept_ids": [
    "baseline-and-caniuse",
    "baseline-lifecycle",
    "caniuse-tables"
  ],
  "source_ids": [
    "web-dev-baseline-docs",
    "caniuse-docs",
    "mdn-browser-compat-data-repo"
  ],
  "used_in": [
    "site/src/content/lessons/frontend-engineering/learning-system-and-workstation/how-to-learn-frontend/03-can-i-ship-it.mdx"
  ],
  "guided": {
    "video": "baseline-status-guided"
  },
  "fallback_visual": "web-dev-baseline-docs-mechanism",
  "simulation": {
    "component": "AlgorithmStepper",
    "props": {
      "title": "Baseline label: highlighted cells support the feature",
      "view": "array",
      "code": "const core = [\"Chrome\", \"Chrome Android\", \"Edge\", \"Firefox\",\n  \"Firefox Android\", \"Safari\", \"Safari iOS\"];\nfunction baselineStatus(supportedIn, monthsSinceNewly) {\n  if (!core.every((b) => supportedIn.includes(b)))\n    return \"Limited availability\";\n  if (monthsSinceNewly < 30)\n    return \"Newly available\";\n  return \"Widely available\";\n}",
      "lang": "javascript",
      "speed": 1800,
      "frames": [
        {
          "caption": "Feature X ships in Chrome, Chrome Android and Edge. Four core browsers still lack it, so the label is Limited availability.",
          "array": [
            "Chrome",
            "Chrome Android",
            "Edge",
            "Firefox",
            "Firefox Android",
            "Safari",
            "Safari iOS"
          ],
          "highlight": [
            0,
            1,
            2
          ],
          "vars": {
            "when": "step 1",
            "supported": "3 of 7",
            "months_since_newly": "not started",
            "status": "Limited availability"
          },
          "line": 5
        },
        {
          "caption": "Firefox on desktop and Android ship Feature X. Two core browsers still lack it: still Limited availability.",
          "array": [
            "Chrome",
            "Chrome Android",
            "Edge",
            "Firefox",
            "Firefox Android",
            "Safari",
            "Safari iOS"
          ],
          "highlight": [
            0,
            1,
            2,
            3,
            4
          ],
          "vars": {
            "when": "step 2",
            "supported": "5 of 7",
            "months_since_newly": "not started",
            "status": "Limited availability"
          },
          "line": 5
        },
        {
          "caption": "Safari on macOS ships it. Six of seven is not enough: one missing core browser keeps the label at Limited availability.",
          "array": [
            "Chrome",
            "Chrome Android",
            "Edge",
            "Firefox",
            "Firefox Android",
            "Safari",
            "Safari iOS"
          ],
          "highlight": [
