  "sync": [
    {
      "scene": "lifecycle",
      "preset": "browsers-ship"
    },
    {
      "scene": "stalled",
      "preset": "stalled-clock"
    },
    {
      "scene": "clock",
      "preset": "has-clock"
    }
  ],
  "checkpoints": [
    {
      "id": "six-of-seven",
      "kind": "predict",
      "at": {
        "scene": "lifecycle"
      },
      "prompt": "A feature works in six of the seven core browsers. Which Baseline label does it have?",
      "choices": [
        {
          "text": "Limited availability",
          "correct": true
        },
        {
          "text": "Newly available",
          "misconception": "Thinks most core browsers is enough, but Newly available needs every core browser"
        },
        {
          "text": "Widely available",
          "misconception": "Treats broad support as Widely available, which also needs 30 months after every core browser ships"
        }
      ],
      "explanation": "Baseline has no partial step. While any one core browser lacks the feature, the label is Limited availability. Only the last core browser to ship it moves the label to Newly available.",
      "concept_ids": [
        "baseline-lifecycle"
      ],
      "revisit": "core"
    },
    {
      "id": "start-the-clock",
      "kind": "experiment",
      "at": {
        "scene": "stalled"
      },
      "prompt": "Feature Y has worked in six core browsers for years. Step forward until its label leaves Limited availability. What finally changes the label?",
      "goal": {
        "preset": "stalled-clock",
        "condition": {
          "path": "vars.status",
          "op": "eq",
          "value": "Newly available"
        },
        "hint": "Press Forward until the seventh cell, Safari iOS, is highlighted."
      },
      "explanation": "The years alone change nothing, because the 30-month clock counts from the newly interoperable date. That date exists only when the last core browser ships the feature, so Safari on iOS shipping it is what moves the label.",
      "concept_ids": [
        "baseline-lifecycle"
      ]
    },
    {
      "id": "month-29",
      "kind": "predict",
      "at": {
        "scene": "clock"
      },
      "prompt": "The :has() selector became Newly available in December 2023. Which label does it have in May 2026, 29 months later?",
      "choices": [
        {
          "text": "Newly available",
          "correct": true
        },
        {
          "text": "Widely available",
          "misconception": "Rounds 29 months up, or counts from the first browser that shipped instead of the last"
        },
        {
          "text": "Limited availability",
          "misconception": "Thinks a feature drops back to Limited while it waits for the 30 months"
        }
      ],
      "explanation": "Widely available starts when 30 months have passed since the newly interoperable date. 29 is less than 30, so :has() stays Newly available until June 2026.",
      "concept_ids": [
        "baseline-lifecycle"
      ],
      "revisit": "lifecycle"
    },
    {
      "id": "reach-widely",
      "kind": "experiment",
      "at": {
        "tab": "practice"
      },
      "prompt": "Run the :has() clock forward until the label reads Widely available. In which month does it change?",
      "goal": {
        "preset": "has-clock",
        "condition": {
          "path": "vars.status",
          "op": "eq",
          "value": "Widely available"
        },
        "hint": "Press Forward until months_since_newly reaches 30."
      },
      "explanation": "Every core browser already supports :has(), so only time moves the label. At 30 months after December 2023, which is June 2026, the label changes to Widely available.",
      "concept_ids": [
        "baseline-lifecycle",
        "baseline-and-caniuse"
      ]
    },
    {
      "id": "greenish-yellow",
      "kind": "verify",
      "at": {
        "tab": "practice"
      },
      "prompt": "In a Can I use table, the cell for one browser is greenish yellow. What does that cell tell you?",
      "choices": [
        {
          "text": "That browser has partial support",
          "correct": true
        },
        {
          "text": "That browser fully supports the feature",
          "misconception": "Reads any color that is not red as full support"
        },
        {
          "text": "Nobody knows if that browser supports it",
          "misconception": "Confuses partial support with gray, which means support unknown"
        }
      ],
      "explanation": "The Can I use legend uses four colors: green for supported, red for not supported, greenish yellow for partial support, and gray for unknown. Partial support means you must check which part works before you rely on it.",
      "concept_ids": [
        "caniuse-tables"
      ]
    }
  ]
}
