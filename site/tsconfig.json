{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "public/media"],
  "compilerOptions": {
    "strictNullChecks": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@topics/*": ["./src/components/topics/*"],
      "@learn/*": ["./src/components/learn/*"],
      "@lib/*": ["./src/lib/*"]
    }
  }
}
