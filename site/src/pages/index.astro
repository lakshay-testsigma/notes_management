---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import { loadDomains } from '../lib/topics';
import { readJson, repoRoot } from '../lib/paths';
import { SITE_DESCRIPTION, SITE_TITLE } from '../site.config';

const domains = loadDomains();
// Roadmaps (state/roadmaps/<slug>/roadmap.json): each links to its generated checklist page.
const roadmapsDir = path.join(repoRoot(), 'state', 'roadmaps');
const roadmaps = (fs.existsSync(roadmapsDir) ? fs.readdirSync(roadmapsDir) : [])
	.map((slug) => readJson<{ id: string; title: string; goal?: string; phases?: { sections?: { topic?: unknown }[] }[] }>(path.join(roadmapsDir, slug, 'roadmap.json')))
	.filter((r): r is NonNullable<typeof r> => !!r && typeof r.id === 'string')
	.filter((r) => fs.existsSync(path.join(repoRoot(), 'site', 'public', 'roadmaps', `${r.id}.html`)))
	.map((r) => ({ ...r, topicCount: (r.phases ?? []).flatMap((p) => p.sections ?? []).filter((s) => s.topic).length }));
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1 class="page-title">{SITE_TITLE}</h1>
	<p class="lede">Each topic is one numbered path. Open a topic, start at 01, and keep pressing Next.</p>
	<p data-continue="" hidden>Continue reading: <a href="/">last page</a></p>

	{
		roadmaps.length > 0 && (
			<>
				<h2>Roadmaps</h2>
				<ul class="index-list">
					{roadmaps.map((roadmap) => (
						<li>
							<a class="index-title" href={`/roadmaps/${roadmap.id}.html`}>
								{roadmap.title}
							</a>{' '}
							<span class="index-meta">{plural(roadmap.topicCount, 'topic')}</span>
							{roadmap.goal && <p>{roadmap.goal}</p>}
						</li>
					))}
				</ul>
				<h2>Topics</h2>
			</>
		)
	}

	{
		domains.length === 0 ? (
			<p>
				There are no topics yet. Ask the tutor to teach you something (for example "teach me Redis Streams") and the
				topic will appear here once its first stage is written.
			</p>
		) : (
			<ul class="index-list">
				{domains.map((domain) => (
					<li>
						<a class="index-title" href={`/${domain.info.id}/`}>
							{domain.info.title}
						</a>{' '}
						<span class="index-meta">{plural(domain.topicCount, 'topic')}</span>
						{domain.info.description && <p>{domain.info.description}</p>}
						<p>
							{domain.subdomains
								.flatMap((sub) => sub.topics)
								.slice(0, 6)
								.map((topic, i) => (
									<>
										{i > 0 && ', '}
										<a href={topic.url}>{topic.title}</a>
									</>
								))}
							{domain.topicCount > 6 && `, and ${domain.topicCount - 6} more`}
						</p>
					</li>
				))}
			</ul>
		)
	}
</Base>

<script>
	import '../scripts/continue';
</script>
