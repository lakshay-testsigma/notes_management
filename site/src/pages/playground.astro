---
import Crumbs from '../components/site/Crumbs.astro';
import { lessonComponents as C } from '../components/learn';
import * as sample from '../data/playground';
import { cacheScene } from '../data/progressive-scenes';
import Base from '../layouts/Base.astro';
import { loadTopics } from '../lib/topics';
import DiagramView from '../components/learn/views/DiagramView.astro';
import VideoView from '../components/learn/views/VideoView.astro';
import ExperienceView from '../components/learn/views/ExperienceView.astro';
import type { BuiltExperience } from '../lib/experience-logic';
import type { VisualEntry } from '../lib/visuals';
import demoHttp from '../data/demo/experiences/http-request-lifecycle.json';
import demoBinary from '../data/demo/experiences/binary-search.json';
import demoConsensus from '../data/demo/experiences/distributed-consensus.json';
import demoFunnel from '../data/demo/experiences/marketing-funnel-strategy.json';
import DepthControl from '../components/site/DepthControl.astro';
import writePathSvg from '../data/demo/write-path.svg?raw';
import demoTranscript from '../data/demo/raft-write-commit.transcript.md?raw';

// <Resources /> needs a topic outside a lesson: use the first one that has sources.
const withSources = loadTopics().find((topic) => topic.sources.length > 0);
// Demo experiences, one per mode: regenerate with `node scripts/demo-experiences.mjs`.
type Demo = { config: unknown; fallback: unknown; fallbackSource: string | null };
const demos = [
	{ key: 'explainer', title: 'Mode A: explainer video (HTTP request lifecycle)', demo: demoHttp as Demo },
	{ key: 'interactive', title: 'Mode B: interactive video lesson (binary search)', demo: demoBinary as Demo },
	{ key: 'branching', title: 'Mode C: branching presentation (marketing funnel strategy)', demo: demoFunnel as Demo },
	{ key: 'hybrid', title: 'Mode D: hybrid learning lab (distributed consensus)', demo: demoConsensus as Demo },
];
---

<Base title="Playground" description="Every shared lesson component with sample data.">
	<Crumbs items={[{ label: 'Home', href: '/' }]} />
	<h1 class="page-title">Playground</h1>
	<p class="lede">
		Every shared lesson component with sample data. Use it to see what a component does before choosing it for a page. The
		props are documented in <code>site/COMPONENTS.md</code>.
	</p>

	<h2 id="visual">Visual</h2>

	<h3 id="FlowAnimation">FlowAnimation</h3>
	<p>Something moving through a system, step by step. Nodes can be switched off to see what breaks.</p>
	<C.FlowAnimation {...sample.flow} />

	<h3 id="ProgressiveScene">ProgressiveScene</h3>
	<p>A persistent isometric diagram that gains blocks, paths and information as the learner advances. <a href="/scene-lab/">Try two focused examples</a>.</p>
	<C.ProgressiveScene {...cacheScene} />

	<h3 id="SystemDiagram">SystemDiagram</h3>
	<p>The parts of a system. Selecting a part explains it under the diagram.</p>
	<C.SystemDiagram {...sample.system} />

	<h3 id="SequenceDiagram">SequenceDiagram</h3>
	<p>Who says what to whom, one message at a time.</p>
	<C.SequenceDiagram {...sample.sequence} />

	<h3 id="StateMachine">StateMachine</h3>
	<p>One thing changing state. The learner sends the events.</p>
	<C.StateMachine {...sample.machine} />

	<h3 id="Graph3D">Graph3D</h3>
	<p>A network in three dimensions. In editable mode the learner can add, connect and remove parts.</p>
	<C.Graph3D {...sample.graph} />

	<h3 id="VectorSpace3D">VectorSpace3D</h3>
	<p>Points in space with a movable query and its nearest neighbours.</p>
	<C.VectorSpace3D {...sample.space} />

	<h3 id="Chart">Chart</h3>
	<p>Line, bar and scatter charts from rows of data.</p>
	<C.Chart {...sample.lineChart} />
	<C.Chart {...sample.barChart} />
	<C.Chart {...sample.scatterChart} />

	<h3 id="ParamPlayground">ParamPlayground</h3>
	<p>Sliders and toggles that drive a formula, written as a plain string.</p>
	<C.ParamPlayground {...sample.params} />

	<h3 id="CodeWalkthrough">CodeWalkthrough</h3>
	<p>Code read a few highlighted lines at a time.</p>
	<C.CodeWalkthrough {...sample.code} />

	<h3 id="Timeline">Timeline</h3>
	<p>Events in order. Select a point or use the arrow keys.</p>
	<C.Timeline {...sample.timeline} />

	<h3 id="Mermaid">Mermaid</h3>
	<p>A static diagram written in mermaid syntax.</p>
	<C.Mermaid {...sample.mermaid} />

	<h3 id="Diagram">Diagram</h3>
	<p>A registered diagram from the topic's visual registry, the same file the Obsidian note embeds. Zoom, drag and reset.</p>
	<DiagramView entry={sample.demoDiagram} sources={[]} inline={writePathSvg} />
	<DiagramView entry={sample.demoMermaid} sources={[]} inline={sample.demoMermaidSource} />

	<h3 id="Video">Video</h3>
	<p>A HyperFrames explainer rendered by <code>tutor video &lt;topic&gt; render &lt;id&gt;</code>, with captions and a transcript.</p>
	<VideoView entry={sample.demoVideo} sources={[]} transcript={demoTranscript} />

	<h3 id="ClusterSim">ClusterSim</h3>
	<p>A small cluster to run and break: quorum replication, gossip, or load balancing.</p>
	<C.ClusterSim {...sample.cluster} />
	<C.ClusterSim {...sample.gossip} />
	<C.ClusterSim {...sample.balancer} />

	<h3 id="AlgorithmStepper">AlgorithmStepper</h3>
	<p>A precomputed algorithm trace, one step at a time.</p>
	<C.AlgorithmStepper {...sample.stepper} />
	<C.AlgorithmStepper {...sample.stepperBars} />

	<h3 id="CompareView">CompareView</h3>
	<p>Two approaches with measured trade-offs; the verdict waits until the learner asks.</p>
	<C.CompareView {...sample.compare} />

	<h3 id="CodePlayground">CodePlayground</h3>
	<p>Editable JavaScript that runs in a sandboxed frame with no network access.</p>
	<C.CodePlayground {...sample.playgroundCode} />

	<h3 id="Experience">Experience</h3>
	<p>
		An adaptive experience built by <code>tutor experience &lt;topic&gt; build &lt;id&gt;</code>. The selector picks the mode per idea:
		watch when explanation is enough, interact when experimentation matters, explore paths when decisions matter, combine everything
		when the idea is complex. Demo sources are placeholders.
	</p>
	{
		demos.map(({ key, title, demo }) => (
			<section data-demo-experience={key}>
				<h4>{title}</h4>
				<ExperienceView config={demo.config as BuiltExperience} fallback={demo.fallback as VisualEntry | null} fallbackInline={demo.fallbackSource ?? undefined} />
			</section>
		))
	}

	<h2 id="activity">Activity</h2>

	<h3 id="Quiz">Quiz</h3>
	<C.Quiz {...sample.quiz} />
	<C.Quiz {...sample.multiQuiz} />

	<h3 id="PredictReveal">PredictReveal</h3>
	<C.PredictReveal {...sample.predict} />
	<C.PredictReveal {...sample.predictOpen} />

	<h3 id="OrderSteps">OrderSteps</h3>
	<C.OrderSteps {...sample.order} />

	<h3 id="MatchPairs">MatchPairs</h3>
	<C.MatchPairs {...sample.match} />

	<h3 id="SortBuckets">SortBuckets</h3>
	<C.SortBuckets {...sample.sortBuckets} />

	<h2 id="utility">Utility</h2>

	<h3 id="Depth">Depth</h3>
	<p>Deeper layers of explanation. The control chooses how much to show.</p>
	<DepthControl />
	<C.Depth level="internals">
		<p>Each consumer group stores a pending entries list. XREADGROUP adds the delivered entry id; XACK removes it.</p>
	</C.Depth>
	<C.Depth level="production">
		<p>Teams alert on the pending list length and move entries that fail too often to a dead-letter stream.</p>
	</C.Depth>

	<h3 id="Figure">Figure</h3>
	<C.Figure caption="Figure wraps an image, or any content, and gives it a caption.">
		<svg viewBox="0 0 640 120" width="100%" role="img" aria-label="Three circles joined by lines">
			<path d="M120 60 H320 H520" fill="none" stroke="var(--line-strong)" stroke-width="2"></path>
			<circle cx="120" cy="60" r="22" fill="var(--s1)"></circle>
			<circle cx="320" cy="60" r="22" fill="var(--s2)"></circle>
			<circle cx="520" cy="60" r="22" fill="var(--s3)"></circle>
		</svg>
	</C.Figure>

	<h3 id="Resources">Resources</h3>
	<p>
		The vetted sources of a topic, grouped by type. Inside a lesson it takes no props.
		{withSources ? ` Shown here for "${withSources.title}".` : ' No topic with sources exists yet, so the list is empty.'}
	</p>
	<C.Resources topic={withSources?.id} />
</Base>
