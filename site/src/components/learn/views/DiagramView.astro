---
// Renders one registered diagram: title, the zoomable figure (SVG, mermaid or
// image from the topic's vault assets), the short explanation, and its sources.
// Used by <Diagram /> (registry lookup) and by the playground (demo data).
import type { Source } from '../../../lib/topics';
import { imageDataUri, readRepoFile, sanitizeSvg, type VisualEntry } from '../../../lib/visuals';

interface Props {
	entry: VisualEntry;
	sources: Source[];
	/** Inline asset text, for demo data that has no file in the repository. */
	inline?: string;
}
const { entry, sources, inline } = Astro.props;
const raw = inline ?? readRepoFile(entry.file);
// The figure container carries the text alternative; the inlined SVG is hidden
// from assistive technology so the diagram is announced once.
const svg = entry.format === 'svg' && raw
	? sanitizeSvg(raw).replace(/<svg\b([^>]*)>/, (_, attrs) => `<svg${attrs.replace(/\s(role|aria-labelledby|aria-label)\s*=\s*("[^"]*"|'[^']*')/g, '')} aria-hidden="true" focusable="false">`)
	: null;
const mermaid = entry.format === 'mermaid' && raw ? raw.trim() : null;
const image = entry.format === 'image' ? imageDataUri(entry.file) : null;
const problem = !svg && !mermaid && !image ? `The asset of diagram "${entry.id}" (${entry.file ?? 'no file'}) could not be read.` : null;
const descId = `diagram-desc-${entry.id}`;
---

<figure class="lc lc-diagram" data-diagram={entry.id} aria-labelledby={`diagram-title-${entry.id}`} aria-describedby={descId}>
	<figcaption class="lc-title" id={`diagram-title-${entry.id}`}>{entry.title}</figcaption>
	{
		problem ? (
			<p class="lc-error">{problem}</p>
		) : (
			<>
				<div class="lc-zoom" data-zoom tabindex="0" role="img" aria-label={entry.alt}>
					<div class="lc-zoom-content" data-zoom-content>
						{svg && <Fragment set:html={svg} />}
						{mermaid && <pre data-mermaid>{mermaid}</pre>}
						{image && <img src={image} alt="" />}
					</div>
				</div>
				<div class="lc-controls" aria-label="Diagram zoom">
					<button type="button" class="lc-btn" data-zoom-in aria-label="Zoom in">Zoom in</button>
					<button type="button" class="lc-btn" data-zoom-out aria-label="Zoom out">Zoom out</button>
					<button type="button" class="lc-btn" data-zoom-reset>Reset view</button>
					<span class="lc-controls-note">Drag to move. Plus and minus keys zoom.</span>
				</div>
			</>
		)
	}
	<p class="lc-caption" id={descId}>{entry.explanation}</p>
	{
		sources.length > 0 && (
			<p class="lc-diagram-sources">
				Based on{' '}
				{sources.map((s, i) => (
					<>
						{i > 0 && ', '}
						<a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}</a>
					</>
				))}
				.
			</p>
		)
	}
</figure>

<script>
	// Zoom and pan without a framework: scale and translate the content box.
	function wire(host: HTMLElement) {
		const figure = host.closest('figure');
		const content = host.querySelector<HTMLElement>('[data-zoom-content]');
		if (!figure || !content || host.dataset.zoomReady) return;
		host.dataset.zoomReady = 'true';
		let scale = 1, x = 0, y = 0, dragging = false, startX = 0, startY = 0;
		const apply = () => {
			content.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
			host.classList.toggle('is-zoomed', scale !== 1 || x !== 0 || y !== 0);
		};
		const zoom = (factor: number) => {
			scale = Math.min(4, Math.max(0.5, Math.round(scale * factor * 100) / 100));
			apply();
		};
		const reset = () => {
			scale = 1; x = 0; y = 0;
			apply();
		};
		figure.querySelector('[data-zoom-in]')?.addEventListener('click', () => zoom(1.25));
		figure.querySelector('[data-zoom-out]')?.addEventListener('click', () => zoom(0.8));
		figure.querySelector('[data-zoom-reset]')?.addEventListener('click', reset);
		host.addEventListener('keydown', (event) => {
			if (event.key === '+' || event.key === '=') { zoom(1.25); event.preventDefault(); }
			else if (event.key === '-') { zoom(0.8); event.preventDefault(); }
			else if (event.key === '0') { reset(); event.preventDefault(); }
			else if (scale !== 1 && event.key.startsWith('Arrow')) {
				const step = 30;
				if (event.key === 'ArrowLeft') x += step;
				if (event.key === 'ArrowRight') x -= step;
				if (event.key === 'ArrowUp') y += step;
				if (event.key === 'ArrowDown') y -= step;
				apply();
				event.preventDefault();
			}
		});
		host.addEventListener('pointerdown', (event) => {
			if (scale === 1) return;
			dragging = true;
			startX = event.clientX - x;
			startY = event.clientY - y;
			host.setPointerCapture(event.pointerId);
		});
		host.addEventListener('pointermove', (event) => {
			if (!dragging) return;
			x = event.clientX - startX;
			y = event.clientY - startY;
			apply();
		});
		host.addEventListener('pointerup', () => { dragging = false; });
		host.addEventListener('pointercancel', () => { dragging = false; });
	}
	document.querySelectorAll<HTMLElement>('[data-zoom]').forEach(wire);
</script>
