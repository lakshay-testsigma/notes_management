  "plan": {
    "summary": "Retrieval-augmented generation (RAG) is a way to make a language model answer from documents it was never trained on: the application first finds the few most relevant passages, then puts them into the prompt so the model writes its answer from them.",
    "prerequisites": [
      {
        "concept": "Large language model",
        "known": false,
        "bridge": "A large language model is a program that continues text one small piece at a time; it only knows what was in its training data, which stopped at a fixed date and did not include your private files."
      },
      {
        "concept": "Context window",
        "known": false,
        "bridge": "The context window is all the text a model can read in one call (your instructions plus anything you paste in); the model forgets everything outside it."
      },
      {
        "concept": "Embedding",
        "known": false,
        "bridge": "An embedding is a list of numbers that stands for the meaning of a piece of text, so that texts with similar meaning get lists of numbers that are close together."
      },
      {
        "concept": "Python basics",
        "known": false,
        "bridge": "The project uses plain Python: functions, lists, dictionaries, and reading a text file are enough."
      }
    ],
    "outcomes": [
      "Explain why a language model on its own cannot answer questions about private or recent documents, and how adding retrieved text to the prompt fixes that.",
      "Explain how embeddings and cosine similarity choose the top-k chunks for a question.",
      "Build a small RAG pipeline in Python that chunks documents, retrieves the best chunks for a question, and builds a prompt that makes the answer cite its sources.",
      "Decide when to use RAG instead of fine-tuning or simply pasting the whole document into the prompt.",
      "Diagnose a wrong answer as a retrieval failure or a generation failure, and name the usual fix for each."
    ],
    "lesson_outline": [
      {
        "order": 1,
        "slug": "why-rag-exists",
        "title": "Why a model needs to look things up",
        "visual": "FlowAnimation",
        "activity": "PredictReveal"
      },
      {
        "order": 2,
        "slug": "retrieval-by-meaning",
        "title": "Retrieval: finding text by meaning",
        "visual": "VectorSpace3D",
        "activity": "Quiz"
      },
      {
        "order": 3,
        "slug": "chunking-documents",
        "title": "Chunking: cutting documents into pieces worth retrieving",
        "visual": "ParamPlayground",
        "activity": "OrderSteps"
      },
      {
        "order": 4,
        "slug": "rag-in-production",
        "title": "RAG in production: where it breaks and how teams fix it",
        "visual": "SystemDiagram",
        "activity": "MatchPairs"
      }
    ],
    "mini_projects": [
      {
        "n": 1,
        "slug": "handbook-qa",
        "use_case": "A new employee asks questions about the company handbook, and the people team needs every answer to quote the handbook section it came from, or to say plainly that the handbook does not cover it."
      }
    ],
    "digest_targets": 2,
    "repo_targets": 0,
    "capstone": {
      "name": "Docs assistant service",
      "problem": "A software company's support team answers the same product questions every day; they need an HTTP service that answers from the product documentation with citations, refuses when the docs do not cover the question, and reports retrieval quality on a fixed test set after every documentation update."
    }
  },
