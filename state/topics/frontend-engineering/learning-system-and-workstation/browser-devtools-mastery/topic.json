  "plan": {
    "summary": "Browser DevTools are the inspectors built into every browser that show the live page, its code, network, performance and memory, so you can find the cause of a bug from evidence.",
    "prerequisites": [
      {
        "concept": "Basic programming",
        "known": true,
        "bridge": ""
      },
      {
        "concept": "Command line",
        "known": true,
        "bridge": ""
      },
      {
        "concept": "DOM",
        "known": false,
        "bridge": "The DOM is the live tree of objects for page elements."
      },
      {
        "concept": "HTTP",
        "known": false,
        "bridge": "HTTP is how a browser asks a server for files."
      }
    ],
    "outcomes": [
      "Explain the phases of a network request shown in the waterfall.",
      "Debug async JavaScript with conditional breakpoints and async call stacks.",
      "Find a memory leak by comparing heap snapshots and reading retainers.",
      "Build a scripted page health report with the Chrome DevTools Protocol.",
      "Decide which DevTools panel to open first for a given symptom."
    ],
