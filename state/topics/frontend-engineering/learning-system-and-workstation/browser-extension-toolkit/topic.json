  "plan": {
    "summary": "A browser extension toolkit adds framework, performance, accessibility, SEO and security views that built-in DevTools does not give.",
    "prerequisites": [
      {
        "concept": "Browser developer tools",
        "known": false,
        "bridge": "Built-in browser panels that inspect and debug a live page."
      },
      {
        "concept": "Browser extension",
        "known": false,
        "bridge": "A small add-on program that adds features to the browser."
      },
      {
        "concept": "Document Object Model",
        "known": false,
        "bridge": "The DOM is the tree of objects the browser builds from HTML."
      },
      {
        "concept": "HTTP request and response",
        "known": false,
        "bridge": "The browser sends a request; the server returns status, headers and body."
      }
    ],
    "outcomes": [
      "Explain how a framework devtools extension reads component state from a page.",
      "Explain what automated accessibility and SEO checks catch and what they miss.",
      "Build a script that audits extension manifests for risky permissions.",
      "Build an accessibility and SEO check that runs on every release page.",
      "Decide when to use an extension instead of a built-in DevTools panel."
    ],
    "lesson_outline": [
