  "plan": {
    "summary": "How a browser turns a URL into pixels: its processes, navigation and lifecycle, the critical rendering path and compositing, the JavaScript engine, the event loop, storage and the same-origin policy.",
    "prerequisites": [
      {
        "concept": "Browser developer tools",
        "known": true
      },
      {
        "concept": "HTTP request and response",
        "known": true
      },
      {
        "concept": "Document Object Model",
        "known": false,
        "bridge": "The DOM is the tree of objects the browser builds from HTML."
      },
      {
        "concept": "Call stack",
        "known": false,
        "bridge": "The list of functions running now, newest on top."
      }
    ],
    "outcomes": [
      "Explain which browser process does which job and why sites are isolated.",
      "Explain each step from a navigation to the first paint, and the lifecycle events that follow.",
      "Find and fix render-blocking and parser-blocking resources on a page.",
      "Choose CSS properties that animate on the compositor only.",
      "Predict the order in which tasks, microtasks and rendering steps run.",
      "Choose the right browser storage API and explain what the same-origin policy isolates."
    ],
