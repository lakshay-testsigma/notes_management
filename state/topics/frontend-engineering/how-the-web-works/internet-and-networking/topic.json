  "plan": {
    "summary": "The network layers under every web page: packets, DNS, HTTP and its versions, TLS, URLs and origins, caching, CDNs, compression, cookies, realtime transports and API styles.",
    "prerequisites": [
      {
        "concept": "Browser developer tools",
        "known": true
      },
      {
        "concept": "HTTP request and response",
        "known": false,
        "bridge": "The browser sends a request; the server returns status, headers and body."
      },
      {
        "concept": "Client and server",
        "known": false,
        "bridge": "A client asks for data; a server listens and answers."
      },
      {
        "concept": "Network packet",
        "known": false,
        "bridge": "A small block of data with a header that says where it goes."
      }
    ],
    "outcomes": [
      "Explain what happens on the network between typing a URL and the first byte of the page.",
      "Explain how DNS resolves a name and choose the right record type and TTL.",
      "Compare HTTP/1.1, HTTP/2 and HTTP/3 and explain head-of-line blocking at each layer.",
      "Explain the TLS 1.3 handshake and the certificate chain of trust.",
      "Configure HTTP caching, CDN caching and compression for a static site with hashed assets.",
      "Set cookies with safe attributes and explain origin versus site.",
      "Choose a realtime transport and an API style for a product feature."
    ],
